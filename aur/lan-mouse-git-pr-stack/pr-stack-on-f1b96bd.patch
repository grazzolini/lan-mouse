+impl Display for ClipboardEvent {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            ClipboardEvent::Text(text) => {
+                let preview = if text.len() > 50 {
+                    format!("{}...", &text[..50])
+                } else {
+                    text.clone()
+                };
+                write!(f, "clipboard(text: {preview})")
+            }
+        }
+    }
+}
