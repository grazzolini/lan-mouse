+    /// macOS bundle identifier, e.g. `com.1password.1password7`.
+    MacBundle(String),
+    /// Windows executable basename (lowercased), e.g.
+    /// `1password.exe`.
+    WindowsExe(String),
+    /// X11 `WM_CLASS` instance/name (lowercased), e.g. `firefox`.
