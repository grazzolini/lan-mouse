+        let bytes = encode_clipboard_event(&event).expect("encode");
+        let truncated = &bytes[..bytes.len() - 1];
+        assert!(matches!(
+            decode_clipboard_event(truncated),
+            Err(ProtocolError::BufferTooSmall)
+        ));
+    }
