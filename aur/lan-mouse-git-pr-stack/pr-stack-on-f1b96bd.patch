+            | (AppIdent::WindowsExe(a), AppIdent::WindowsExe(b))
+            | (AppIdent::LinuxX11(a), AppIdent::LinuxX11(b))
+            | (AppIdent::LinuxWayland(a), AppIdent::LinuxWayland(b)) => a.eq_ignore_ascii_case(b),
+            _ => false,
+        }
+    }
